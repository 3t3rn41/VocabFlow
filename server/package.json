{
  "name": "vocabflow-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/vocabflow-server-bundle.cjs --external:sql.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "sql.js": "^1.12.0",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.0"
  }
}
